# Only keep bootstrap + secret env here.
# Non-sensitive runtime settings now live in the shared main config DB.

# ========== Main Tracking DB ==========
# Leave DATABASE_URL blank to use the root SQLite fallback.
DATABASE_URL=
DB_SCHEMA=censai
CENSAI_CENTRAL_DB_ENABLED=true
CENSAI_MAIN_SQLITE_PATH=censai.sqlite3

# ========== Secrets ==========
# Required only if you enable LLM Gateway in central config.
LLM_GATEWAY_API_KEY=

# Optional bootstrap media roots for the worker/UI scanner.
# Use a comma-separated list when you want to scan multiple mounted paths.
# CENSAI_MEDIA_FOLDERS=/media/tv,/media/movies

# Optional bootstrap override if your Gateway is not at the built-in default.
# LLM_GATEWAY_URL=http://llmgateway.llmgateway.svc.cluster.local:8000
